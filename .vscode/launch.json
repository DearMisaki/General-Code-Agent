{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Current File",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "dlvFlags": ["--check-go-version=false"]
    },
    {
      "name": "Debug mewcode",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/mewcode",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "dlvFlags": ["--check-go-version=false"]
    },
    {
      "name": "Debug Current Test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "console": "integratedTerminal",
      "dlvFlags": ["--check-go-version=false"]
    }
  ]
}